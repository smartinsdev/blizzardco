generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accounts {
  id           BigInt    @id @unique(map: "f43f43") @default(autoincrement())
  username     String    @unique @default("") @db.VarChar(16)
  password     String?   @default("") @db.VarChar(16)
  email        String?   @default("") @db.VarChar(100)
  state        BigInt?
  earthID      String    @default("") @db.VarChar(20)
  question     String?   @db.VarChar(100)
  answer       String?   @db.VarChar(30)
  country      String?   @db.VarChar(110)
  city         String?   @db.VarChar(100)
  ip           String?   @db.VarChar(100)
  phone        String?   @db.VarChar(15)
  online       Int?      @default(0) @db.TinyInt
  name         String?   @default("") @db.VarChar(16)
  entityId     BigInt?   @default(0) @db.UnsignedBigInt
  macs         String?   @db.VarChar(220)
  bannedId     BigInt?   @default(2)
  code         String?   @db.VarChar(255)
  mobileNumber String?   @db.VarChar(255)
  securityCode String?   @db.VarChar(255)
  creation     DateTime? @db.DateTime(6)
  hwid         String?   @db.VarChar(255)

  @@index([username], map: "ggg")
}

